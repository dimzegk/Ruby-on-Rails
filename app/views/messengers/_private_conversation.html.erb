<% recipient    ||= @recipient %>
<% conversation ||= @conversation %>
<%= render "messengers/contact_cta", conversation: conversation, current_user: current_user %>

<div class="conversation d-flex flex-column h-100"
     data-pconversation-id="<%= conversation.id %>">


  <%= turbo_stream_from "u#{current_user.id}:pc#{conversation.id}" %>

  <%= render "messengers/private_conversation/details", recipient: recipient %>


  <div class="messages-list flex-grow-1" id="pc<%= conversation.id %>-messages">
    <%= render "private/conversations/conversation/messages_list",
               conversation: conversation,
               current_user: current_user %>
  </div>


  <div class="border-top p-2">
    <%= render "private/conversations/conversation/new_message_form",
               conversation: conversation,
               current_user: current_user %>
  </div>
</div>
