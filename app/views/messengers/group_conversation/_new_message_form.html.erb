<%= form_with url: group_messages_path, method: :post, local: false, html: { class: "send-group-message" } do |f| %>
  <%= hidden_field_tag :conversation_id, conversation.id %>
  <div class="d-flex gap-2">
    <textarea name="body" rows="2" class="form-control" placeholder="Type a message..." required></textarea>
    <button type="button" class="btn btn-primary send-message">Send</button>
  </div>
<% end %>
