<% r = local_assigns[:recipient] || @recipient %>

<% if r.present? %>
  <div class="add-user-to-contacts-message">
    <div>
      <%= h(r.name) %> is not in your contacts
    </div>

    <div class="mt-2">
      <%= button_to "Add to contacts",
            contacts_path,
            method: :post,
            remote: true,
            params: { contact_id: r.id },
            class: "btn btn-sm btn-primary" %>
    </div>
  </div>
<% else %>
  <!-- No recipient available; nothing to show -->
<% end %>
