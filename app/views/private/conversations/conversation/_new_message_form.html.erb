<%= form_with url: private_conversation_messages_path(conversation),
              method: :post,
              scope:  :message,
              html:   { id: "pc#{conversation.id}-form", class: "chat-composer d-grid gap-2" } do |f| %>
  <%= f.text_area :body,
                  rows: 2,
                  class: "form-control",
                  placeholder: "Type a message...",
                  required: true,
                  autocomplete: "off" %>
  <%= f.submit "Send", class: "btn btn-primary ms-auto" %>
<% end %>
