<%= render add_to_contacts_partial_path(@contact, @recipient) %>
<%= render unaccepted_contact_request_partial_path(@contact) %>
<%= render not_contact_no_request_partial_path(@contact, @recipient) %>
<%= render 'private/conversations/conversation/heading/app_group_chat_button', conversation: conversation, recipient: @recipient %>

<div class="<%= conv_heading_class(@contact) %>">
  <span class="contact-name-notif"><%= @recipient.name %></span>
  <%= link_to "X",
              close_private_conversation_path(conversation.id),
              class: 'close-conversation',
              title: 'Close',
              remote: true,
              method: :post %>
</div>
