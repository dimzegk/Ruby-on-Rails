<% ordered = @all_conversations || OrderConversationsService.new(current_user).call %>

<% ordered.each do |item| %>
  <% if item.is_a?(Private::Conversation) %>
    <% conv = item %>
    <% recipient = private_conv_recipient(conv) %>

    <li id="menu-pc<%= conv.id %>" data-type="private" data-id="<%= conv.id %>">

      <a class="dropdown-item navlink-desktop-popup"
         data-remote="true"
         data-turbo="false"
         href="/get_private_conversation.js?id=<%= recipient.id %>">
        <i class="fa-regular fa-user me-2"></i>
        <span class="text-truncate"><%= recipient.name %></span>
      </a>

      <%= link_to open_messenger_path(type: "private", id: recipient.id),
                  class: "dropdown-item navlink-mobile-messenger" do %>
        <i class="fa-regular fa-user me-2"></i>
        <span class="text-truncate"><%= recipient.name %></span>
      <% end %>
    </li>

  <% elsif item.is_a?(Group::Conversation) %>
    <li id="menu-gc<%= item.id %>" data-type="group" data-id="<%= item.id %>">
      <!-- Desktop: POPUP (remote JS) -->
      <a class="dropdown-item navlink-desktop-popup"
         data-remote="true"
         data-turbo="false"
         href="/get_group_conversation.js?group_conversation_id=<%= item.id %>">
        <i class="fa-solid fa-users me-2"></i>
        <span class="text-truncate"><%= item.name %></span>
      </a>


      <%= link_to open_messenger_path(type: "group", group_conversation_id: item.id),
                  class: "dropdown-item navlink-mobile-messenger" do %>
        <i class="fa-solid fa-users me-2"></i>
        <span class="text-truncate"><%= item.name %></span>
      <% end %>
    </li>
  <% end %>
<% end %>
