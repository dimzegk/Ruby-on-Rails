<div class="new-post">
  <h1>New Post</h1>

  <div class="form-card">
    <%= bootstrap_form_for(@post, layout: :vertical) do |f| %>
      <div class="form-row">
        <%= f.text_field :title,
              label: "Title",
              placeholder: "Short, descriptive title",
              maxlength: 100,
              required: true,
              minlength: 5 %>

        <%= f.hidden_field :branch, value: @branch %>

        <%= f.text_area :content,
              label: "Description",
              rows: 6,
              placeholder: "Describe what you’re looking for (interests, expertise level, etc.)",
              required: true,
              minlength: 20,
              maxlength: 1000 %>

        <%= f.collection_select :category_id,
              @categories, :id, :name,
              { include_blank: "Select a category", label: "Category" },
              { class: "form-select" } %>
      </div>

      <div class="form-actions">
        <%= f.submit "Create post", class: "btn btn-primary" %>
        <%= link_to "Cancel", root_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
