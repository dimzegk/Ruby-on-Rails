<div id="branch-main-content" class="container">
  <div class="row">
    <h1 class="page-title text-center"><%= page_title %></h1>
    <%= render 'posts/branch/create_new_post', branch: branch %>
  </div>

  <div class="row">
    <%= render 'posts/branch/search_form',
               branch: branch,
               search_placeholder: search_placeholder %>
  </div>

  <div class="row">
    <%= render 'posts/branch/categories', branch: branch %>
  </div>

  <!-- FEED: responsive grid 1/2/3/4 στήλες -->
  <div class="row g-3" id="feed-grid">
    <%= render @posts %>
    <%= render no_posts_partial_path(@posts) %>
  </div>

  <div class="infinite-scroll">
    <%= will_paginate @posts %>
  </div>
</div>
